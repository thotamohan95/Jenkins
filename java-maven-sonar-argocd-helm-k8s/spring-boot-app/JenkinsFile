
pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
            // Requires Docker CLI and Maven in the agent image.
        }
    }

    environment {
        GIT_REPO_URL = 'https://github.com/thotamohan95/Jenkins.git'
        GIT_BRANCH = 'main'
        GIT_REPO_NAME = 'Jenkins'
        GIT_USER_NAME = 'thotamohan95'

        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        DEPLOYMENT_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'

        // Verify this is your actual Docker Hub username.
        DOCKERHUB_USERNAME = 'thotamohan95'
        DOCKER_IMAGE = "${DOCKERHUB_USERNAME}/ultimate-cicd:${BUILD_NUMBER}"

        // Reach SonarQube on your Windows Docker Desktop host.
        SONAR_URL = 'http://host.docker.internal:9000'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO_URL}"
                sh 'echo "Checkout successful"'
                sh 'ls -la'
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    dir("${APP_DIR}") {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.token="$SONAR_AUTH_TOKEN" \
                              -Dsonar.host.url="$SONAR_URL"
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$DOCKERHUB_TOKEN" | docker login \
                          -u "$DOCKERHUB_USER" --password-stdin

                        docker build -t "$DOCKER_IMAGE" "$APP_DIR"
                        docker push "$DOCKER_IMAGE"

                        docker logout
                    '''
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        git config user.name "$GIT_USER_NAME"
                        git config user.email "jenkins@localhost"

                        sed -i "s|replaceImageTag|${BUILD_NUMBER}|g" \
                          "$DEPLOYMENT_FILE"

                        git add "$DEPLOYMENT_FILE"

                        if git diff --cached --quiet; then
                            echo "No deployment changes to commit."
                        else
                            git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                            git push \
                              "https://x-access-token:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                              "HEAD:${GIT_BRANCH}"
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
