
pipeline {
    agent any

    environment {
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        SONAR_URL = 'http://host.docker.internal:9000'
        DOCKER_IMAGE = "thotamohan95/ultimate-cicd:${BUILD_NUMBER}"
        GIT_REPO_NAME = 'Jenkins'
        GIT_USER_NAME = 'thotamohan95'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code is checked out by Jenkins from SCM.'
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withCredentials([
                        string(
                            credentialsId: 'sonarqube',
                            variable: 'SONAR_AUTH_TOKEN'
                        )
                    ]) {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.host.url="${SONAR_URL}" \
                              -Dsonar.token="${SONAR_AUTH_TOKEN}"
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    dir("${APP_DIR}") {
                        sh 'docker build -t "$DOCKER_IMAGE" .'

                        docker.withRegistry(
                            'https://index.docker.io/v1/',
                            'docker-cred'
                        ) {
                            docker.image("${DOCKER_IMAGE}").push()
                        }
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        git config user.email "thotamohan95@gmail.com"
                        git config user.name "Mohan Thotan"

                        MANIFEST="java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                        if [ ! -f "$MANIFEST" ]; then
                            echo "ERROR: Deployment manifest not found: $MANIFEST"
                            exit 1
                        fi

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" "$MANIFEST"

                        git add "$MANIFEST"

                        if git diff --cached --quiet; then
                            echo "No deployment manifest changes to commit."
                            exit 0
                        fi

                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                        git push "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Console Output for details.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
